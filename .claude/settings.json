{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit *)",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/complexity_before_commit.sh",
            "args": [],
            "statusMessage": "Running the complexity tools before the commit"
          }
        ]
      }
    ]
  }
}
